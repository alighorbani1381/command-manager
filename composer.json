{
  "name": "alighorbani1381/command-manager",
  "description": "Automatically run your artisan commands",
  "keywords": [
    "laravel-command",
    "laravel-automatic-deploy"
  ],
  "homepage": "https://github.com/alighorbani1381/command-manager",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Ali",
      "email": "alighorbani20002@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "8.*|9.*|10.*|11.*|12.*|13.*"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Alighorbani\\CommandManager\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Alighorbani\\CommandManager\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Alighorbani\\CommandManager\\CommandManagerServiceProvider"
      ]
    }
  }
}
